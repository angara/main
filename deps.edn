{
  :deps {
         org.clojure/clojure       {:mvn/version "1.12.6"}
         org.clojure/core.async    {:mvn/version "1.9.865"}
         org.clojure/core.cache    {:mvn/version "1.2.999"}
         org.clojure/core.memoize  {:mvn/version "1.2.281"}

   ;; https://github.com/dm3/clojure.java-time
         clojure.java-time/clojure.java-time {:mvn/version "1.4.3"}
         clj-time/clj-time         {:mvn/version "0.15.2"}  ;; deprecated!
         
         metosin/jsonista          {:mvn/version "1.0.2"}
         metosin/malli             {:mvn/version "0.20.3"}
         http-kit/http-kit         {:mvn/version "2.8.1"}
         hato/hato                 {:mvn/version "1.0.0"}
         redis.clients/jedis       {:mvn/version "8.0.1"}
         mount/mount               {:mvn/version "0.1.24"}

         ring/ring-core            {:mvn/version "1.15.6"}
         ring/ring-jetty-adapter   {:mvn/version "1.15.6"}
         ring/ring-json            {:mvn/version "0.5.1"}
         ring/ring-headers         {:mvn/version "0.4.0"}
         compojure/compojure       {:mvn/version "1.7.2"}
         hiccup/hiccup             {:mvn/version "2.0.0"}

         com.novemberain/monger    {:mvn/version "3.6.0"}

         org.postgresql/postgresql {:mvn/version "42.7.14"}
         funcool/clojure.jdbc      {:mvn/version "0.9.0"}
         hikari-cp/hikari-cp       {:mvn/version "4.1.0"}
         honeysql/honeysql         {:mvn/version "1.0.461"}

         com.draines/postal        {:mvn/version "2.0.5"}

         com.taoensso/telemere       {:mvn/version "1.4.0"}
         com.taoensso/telemere-slf4j {:mvn/version "1.4.0"}
         ,}

  :paths ["src"] ;; "java

  :aliases {:dev {:extra-paths ["dev" "resources"]
                  :extra-deps  {org.clojure/tools.namespace {:mvn/version "1.5.1"}
                                criterium/criterium         {:mvn/version "0.4.6"}}}

            ; https://github.com/djblue/portal
            ; https://practical.li/clojure/data-inspector/portal/            
            :nrepl {:extra-deps {djblue/portal     {:mvn/version "0.68.1"}
                                 nrepl/nrepl       {:mvn/version "1.8.0"}
                                 cider/cider-nrepl {:mvn/version "0.63.1"}}
                    :main-opts ["-m" "nrepl.cmdline"
                                "--middleware" "[cider.nrepl/cider-middleware,portal.nrepl/wrap-portal]"]}

            ;; https://github.com/clojure/tools.build#release-information
            :build   {:extra-paths ["target/resources"]
                      :deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
                      :ns-default build}}
  ,}
